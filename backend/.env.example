# Server Configuration
PORT=5001
NODE_ENV=production

# Database (Supported variables: MONGODB_URI, MONGO_URL, MONGODB_URL, or DATABASE_URL)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/notesguru?retryWrites=true&w=majority
# Ensure 0.0.0.0/0 is added in MongoDB Atlas -> Network Access
MONGODB_URI=mongodb://127.0.0.1:27017/notesguru

# Authentication & Security
JWT_SECRET=super_secret_notes_guru_jwt_token_key_change_in_production

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth 2.0 / GIS
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://kjbnkjg/api/auth/google/callback

# Client URLs (for CORS and redirects)
FRONTEND_URL=https://notes-guru-eight.vercel.app
ADMIN_URL=http://localhost:5174
